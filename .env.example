# ==============================================
# moka-stock 환경변수 예시
# 이 파일을 복사해서 .env 로 사용하세요
# cp .env.example .env
# ==============================================

# -----------------------------------------------
# JWT
# -----------------------------------------------
JWT_SECRET=your-super-secret-jwt-key-change-this
JWT_ACCESS_EXPIRY=3600
JWT_REFRESH_EXPIRY=604800

# -----------------------------------------------
# PostgreSQL (서비스별 독립 DB)
# -----------------------------------------------
POSTGRES_AUTH_HOST=localhost
POSTGRES_AUTH_PORT=5432
POSTGRES_AUTH_DB=moka_auth
POSTGRES_AUTH_USER=moka
POSTGRES_AUTH_PASSWORD=moka1234

POSTGRES_USER_HOST=localhost
POSTGRES_USER_PORT=5433
POSTGRES_USER_DB=moka_user
POSTGRES_USER_USER=moka
POSTGRES_USER_PASSWORD=moka1234

POSTGRES_DASHBOARD_HOST=localhost
POSTGRES_DASHBOARD_PORT=5434
POSTGRES_DASHBOARD_DB=moka_dashboard
POSTGRES_DASHBOARD_USER=moka
POSTGRES_DASHBOARD_PASSWORD=moka1234

POSTGRES_AI_HOST=localhost
POSTGRES_AI_PORT=5435
POSTGRES_AI_DB=moka_ai
POSTGRES_AI_USER=moka
POSTGRES_AI_PASSWORD=moka1234

POSTGRES_BOARD_HOST=localhost
POSTGRES_BOARD_PORT=5436
POSTGRES_BOARD_DB=moka_board
POSTGRES_BOARD_USER=moka
POSTGRES_BOARD_PASSWORD=moka1234

# -----------------------------------------------
# Redis
# -----------------------------------------------
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# -----------------------------------------------
# Anthropic (서버 자체 키 — 운영자 전용)
# 일반 사용자는 프론트 /settings 에서 개인 키 등록
# -----------------------------------------------
ANTHROPIC_API_KEY=sk-ant-your-key-here

# -----------------------------------------------
# 외부 데이터 API
# -----------------------------------------------
# 한국은행 Open API (환율)
BOK_API_KEY=your-bok-api-key

# -----------------------------------------------
# 모니터링
# -----------------------------------------------
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin1234
